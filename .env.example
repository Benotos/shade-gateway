# Copy to .env.local for local dev, and add the same values in Vercel -> Project -> Settings -> Environment Variables.
# Never commit .env.local. Only NEXT_PUBLIC_ values are visible in the browser.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://shade-gateway.vercel.app
SHADE_DEMO_MODE=false
# Your Telegram/X/email link, shown in the footer (e.g. https://t.me/yourname)
NEXT_PUBLIC_SUPPORT_URL=

# --- Models (OpenRouter: one key for GPT, Claude, Gemini, Llama, DeepSeek...) ---
# Get a key at https://openrouter.ai/keys and add credit there. Set a monthly limit on the key.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Models: the built-in lineup (GPT, Claude, Gemini, DeepSeek, Llama) is used by default. Leave this empty unless
# you want a custom list: "id|display name|provider model" entries, comma-separated.
SHADE_MODEL_LIST=
# Price multiplier on provider cost (1.5 = 50% margin).
SHADE_MARKUP=1.5
SHADE_MAX_OUTPUT_TOKENS=4096
SHADE_FREE_DAILY_LIMIT=20

# --- Credits database (Turso: turso.tech -> your database -> Connect) ---
# Tables are created automatically on first request.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Random string used to hash visitor IPs for rate limits (IPs are never stored).
SHADE_IP_SALT=

# --- SOL deposits ---
# The treasury wallet that receives SOL. Use a dedicated wallet; only its PUBLIC address goes here.
SOLANA_TREASURY_ADDRESS=
NEXT_PUBLIC_SOLANA_DEPOSIT_ADDRESS=
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# A dedicated RPC (e.g. Helius/QuickNode free tier) is strongly recommended; the public one rate limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Used only if both price APIs are down.
SOL_USD_FALLBACK=

# Credit packs: id:label:usd:bonus%
SHADE_PACKAGES=starter:Starter:5:0,builder:Builder:20:5,heavy:Heavy:50:10
